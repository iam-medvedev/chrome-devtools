{
  "checkJs": true,
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "checkJs": true,
    "composite": true,
    "declaration": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": true,
    "lib": [
      "dom",
      "dom.iterable",
      "ES2023",
      "ES2024.Promise",
      "ESNext.Iterator",
      "ESNext.Collection",
      "ESNext.Array"
    ],
    "module": "esnext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": ".",
    "rootDir": "../../../../../front_end/foundation",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2023",
    "tsBuildInfoFile": "api_tests-tsconfig.json.tsbuildinfo",
    "typeRoots": [
      "../../../../../node_modules/@types",
      "../../../../../node_modules"
    ],
    "types": [
      "mocha"
    ],
    "useUnknownInCatchVariables": false
  },
  "files": [
    "../../../../../front_end/foundation/Universe.test.api.ts",
    "../../../../../front_end/legacy/legacy-defs.d.ts",
    "../../../../../front_end/global_typings/global_defs.d.ts",
    "../../../../../node_modules/@types/filesystem/index.d.ts",
    "../../../../../test/api/types.d.ts"
  ],
  "references": [
    {
      "path": "./bundle-tsconfig.json"
    },
    {
      "path": "../core/common/bundle-tsconfig.json"
    },
    {
      "path": "../core/root/bundle-tsconfig.json"
    },
    {
      "path": "../generated/protocol-tsconfig.json"
    },
    {
      "path": "../testing/testing-tsconfig.json"
    }
  ]
}